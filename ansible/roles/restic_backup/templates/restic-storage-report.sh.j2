#!/usr/bin/env bash
set -euo pipefail

PRIMARY_ENV_FILE="{{ restic_appdata_env_file }}"
SECONDARY_ENABLED="{{ 'true' if (restic_appdata_secondary_enabled_effective | bool) else 'false' }}"
SECONDARY_ENV_FILE="{{ restic_appdata_secondary_env_file_effective }}"
SOURCE_DIR="{{ restic_appdata_source_dir }}"
CACHE_DIR="{{ restic_cache_dir }}"
S3_CONNECTIONS={{ restic_appdata_s3_connections | default(0) | int }}

mkdir -p "${CACHE_DIR}"
export RESTIC_CACHE_DIR="${CACHE_DIR}"

restic_cmd=(restic)
if [ "${S3_CONNECTIONS}" -gt 0 ]; then
  restic_cmd+=(-o "s3.connections=${S3_CONNECTIONS}")
fi

humanize_bytes() {
  python3 - "$1" <<'PY'
import sys

value = int(sys.argv[1])
units = ["B", "KiB", "MiB", "GiB", "TiB", "PiB"]
size = float(value)
for unit in units:
    if size < 1024 or unit == units[-1]:
        if unit == "B":
            print(f"{int(size)} {unit}")
        else:
            print(f"{size:.3f} {unit}")
        break
    size /= 1024
PY
}

print_field() {
  printf '  %-26s %s\n' "$1" "$2"
}

load_env_file() {
  local env_file="$1"

  if [ ! -r "${env_file}" ]; then
    return 1
  fi

  unset RESTIC_REPOSITORY RESTIC_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION

  # shellcheck disable=SC1090
  set -a
  . "${env_file}"
  set +a

  if [ -z "${RESTIC_REPOSITORY:-}" ] || [ -z "${RESTIC_PASSWORD:-}" ]; then
    return 2
  fi

  if [ -z "${AWS_DEFAULT_REGION:-}" ] && [[ "${RESTIC_REPOSITORY:-}" =~ ^s3:s3\.([^.]+)\.amazonaws\.com/ ]]; then
    AWS_DEFAULT_REGION="${BASH_REMATCH[1]}"
    export AWS_DEFAULT_REGION
  fi

  return 0
}

render_restic_section() {
  local title="$1"
  local env_file="$2"
  local required="${3:-false}"
  local raw_json latest_json load_rc=0

  load_env_file "${env_file}" || load_rc=$?
  if [ "${load_rc}" -ne 0 ]; then
    if [ "${required}" = "true" ]; then
      case "${load_rc}" in
        1)
          echo "Missing required restic env file: ${env_file}" >&2
          ;;
        2)
          echo "Required restic env file is not populated: ${env_file}" >&2
          ;;
      esac
      exit 1
    fi

    printf '%s\n' "${title}"
    case "${load_rc}" in
      1)
        print_field "Status" "not configured (missing ${env_file})"
        ;;
      2)
        print_field "Status" "not configured (${env_file} is empty)"
        ;;
      *)
        print_field "Status" "not configured"
        ;;
    esac
    printf '\n'
    return 0
  fi

  raw_json="$("${restic_cmd[@]}" stats --mode raw-data --json)"
  latest_json="$("${restic_cmd[@]}" stats latest --json)"

  printf '%s\n' "${title}"
  RAW_JSON="${raw_json}" LATEST_JSON="${latest_json}" python3 - <<'PY'
import json
import os

raw = json.loads(os.environ["RAW_JSON"])
latest = json.loads(os.environ["LATEST_JSON"])

def humanize(value: int) -> str:
    units = ["B", "KiB", "MiB", "GiB", "TiB", "PiB"]
    size = float(value)
    for unit in units:
        if size < 1024 or unit == units[-1]:
            if unit == "B":
                return f"{int(size)} {unit}"
            return f"{size:.3f} {unit}"
        size /= 1024
    return f"{value} B"

def line(label: str, value: str) -> None:
    print(f"  {label:<26} {value}")

line("Snapshots retained", str(raw["snapshots_count"]))
line("Stored size", f'{humanize(raw["total_size"])} ({raw["total_size"]} bytes)')
line(
    "Stored uncompressed",
    f'{humanize(raw["total_uncompressed_size"])} ({raw["total_uncompressed_size"]} bytes)',
)
line("Blob count", str(raw["total_blob_count"]))
line("Compression ratio", f'{raw["compression_ratio"]:.2f}x')
line("Compression saving", f'{raw["compression_space_saving"]:.2f}%')
line(
    "Latest restore size",
    f'{humanize(latest["total_size"])} ({latest["total_size"]} bytes)',
)
line("Latest file count", str(latest["total_file_count"]))
PY
  printf '\n'
}

printf 'Backup storage report\n'
print_field "Generated" "$(date -Is)"
print_field "Host" "$(hostname -f 2>/dev/null || hostname)"
print_field "Source path" "${SOURCE_DIR}"

if [ -d "${SOURCE_DIR}" ]; then
  source_bytes="$(du -sb "${SOURCE_DIR}" | awk '{print $1}')"
  print_field "Live source size" "$(humanize_bytes "${source_bytes}") (${source_bytes} bytes)"
else
  print_field "Live source size" "unavailable (${SOURCE_DIR} does not exist)"
fi

if mount_target="$(findmnt -n -o TARGET -T "${SOURCE_DIR}" 2>/dev/null)"; then
  print_field "Mounted on" "${mount_target}"
fi

printf '\n'
render_restic_section "B2 repository" "${PRIMARY_ENV_FILE}" "true"

# AWS secondary repository reporting is disabled with the secondary backup target.
# if [ "${SECONDARY_ENABLED}" = "true" ] || [ -r "${SECONDARY_ENV_FILE}" ]; then
#   render_restic_section "AWS repository" "${SECONDARY_ENV_FILE}" "false"
