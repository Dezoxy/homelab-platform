# Managed by Ansible -- ansible/roles/cloudflare_ddns/templates/cloudflare-ddns.env.j2
# Mode 0600. The API token never appears in argv (where `ps` would show it) or
# in the unit file; systemd reads this file and passes it as environment only.
CF_API_TOKEN={{ cloudflare_ddns_api_token }}
CF_ZONE_ID={{ cloudflare_ddns_zone_id }}
CF_RECORD_NAME={{ cloudflare_ddns_record_name }}
