      "title": "Alloy Service Log Lines / 5m by Host",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "sum by (host) (count_over_time({job=\"systemd-journal\",unit=\"alloy.service\"}[5m]))", "queryType": "range", "refId": "A" }],
