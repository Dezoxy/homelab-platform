    {
      "id": 1,
      "type": "timeseries",
      "title": "Systemd Journal Lines / 5m by Host",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum by (host) (count_over_time({job=\"systemd-journal\"}[5m]))", "queryType": "range", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
