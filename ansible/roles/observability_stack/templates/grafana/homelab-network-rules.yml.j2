{% if observability_adguard_exporter_enabled | default(false) %}
{{ threshold_rule(
  'homelab_adguard_exporter_target_down',
  'Homelab AdGuard exporter target down',
  'up{job="adguard"}',
  1,
  'lt',
  '5m',
  'Prometheus cannot scrape AdGuard exporter metrics for at least 5 minutes.',
  'This may be an exporter-only problem or an AdGuard reachability problem. Check the DNS host and exporter container.',
  'warning',
  'homelab_service',
  'adguard',
  no_data_state='Alerting'
) }}
{% endif %}
{% if observability_blackbox_exporter_enabled | default(false) %}
{{ threshold_rule(
  'homelab_blackbox_probe_down',
  'Homelab HTTP probe down',
  'probe_success{job="blackbox"}',
  1,
  'lt',
  '5m',
  'A blackbox HTTP probe has been failing for at least 5 minutes.',
  'Check the target service, its Traefik route, and the Cloudflare tunnel path for the host in the instance label.',
  'warning',
  'homelab_service',
  'blackbox',
  no_data_state='Alerting'
) }}
{# Renewal failures are silent: Traefik retries from 30 days out and logs the
   error, but nothing surfaces it until the cert actually lapses and every
   probe fails at once (2026-08-23). Alerting on remaining lifetime turns a
   month of failed renewals into a warning on day one of the failure.
   Threshold sits below Let's Encrypt's 30-day renewal window so a healthy
   cert never trips it, and leaves 21 days of runway when it does.
   no_data_state stays OK on purpose: a hard TLS failure drops the metric
   entirely, and homelab_blackbox_probe_down already covers that case. #}
{{ threshold_rule(
  'homelab_blackbox_cert_expiring',
  'Homelab TLS certificate expiring',
  '(probe_ssl_earliest_cert_expiry{job="blackbox"} - time()) / 86400',
  21,
  'lt',
  '1h',
  'A TLS certificate served to the blackbox probes expires in under 21 days.',
  'ACME renewal has most likely been failing for days. Check `journalctl -u traefik | grep -i acme` on 01-reverse-proxy-lxc; the usual causes are a DNS-01 propagation check pointed at the LAN resolver, or a Cloudflare token that cannot write a zone listed in traefik_tls_extra_domains.',
  'warning',
  'homelab_service',
  'blackbox',
  no_data_state='OK'
) }}
{% endif %}

  - orgId: 1
    name: homelab-container-health
    folder: Homelab
    interval: 1m
    rules:
{{ threshold_rule(
  'homelab_cadvisor_target_down',
  'Homelab cAdvisor target down',
  'up{job="cadvisor"}',
  1,
  'lt',
  '5m',
  'Prometheus cannot scrape cAdvisor metrics from a Docker host.',
  'Container-level alerting is degraded on at least one Docker host. Check the cAdvisor service and Docker itself.',
  'warning',
  'homelab_container',
  'cadvisor',
  no_data_state='Alerting'
) }}
{{ threshold_rule(
  'homelab_container_restart_storm',
  'Homelab container restart storm',
  'sum by (container_label_com_docker_compose_project, container_label_com_docker_compose_service) (changes(container_start_time_seconds{job="cadvisor",image!="",container_label_com_docker_compose_service!=""}[15m]))',
  1,
  'gt',
  '5m',
  'A compose service has restarted more than once in the last 15 minutes.',
  'This usually means a crash loop, bad config, or an unhealthy dependency. Check recent logs and deploy changes.',
  'warning',
  'homelab_container',
  'cadvisor',
  query_from=900
) }}
{{ threshold_rule(
  'homelab_container_oom_events',
  'Homelab container OOM events',
  'sum by (container_label_com_docker_compose_project, container_label_com_docker_compose_service) (increase(container_oom_events_total{job="cadvisor",image!="",container_label_com_docker_compose_service!=""}[15m]))',
  0,
  'gt',
  '2m',
  'A compose service has hit an out-of-memory event in the last 15 minutes.',
  'Increase limits, reduce memory pressure, or fix the offending workload before it becomes a restart loop.',
  'critical',
  'homelab_container',
  'cadvisor',
  query_from=900
) }}

  - orgId: 1
    name: homelab-backup-health
    folder: Homelab
    interval: 1m
    rules:
{{ threshold_rule(
  'homelab_restic_backup_stale_warning',
  'Homelab restic appdata backup stale',
  'time() - homelab_restic_backup_last_success_unixtime{job="node-exporter",instance="' ~ observability_backup_node_exporter_target ~ '",backup_set="appdata",target="b2"}',
  129600,
  'gt',
  '15m',
  'The primary appdata restic backup has not completed successfully within 36 hours.',
  'Investigate the backup host, repository credentials, and recent timer/service runs before you lose recovery coverage.',
  'warning',
  'homelab_backup',
  'restic',
  no_data_state='Alerting'
) }}
{{ threshold_rule(
  'homelab_restic_backup_stale_critical',
  'Homelab restic appdata backup critically stale',
  'time() - homelab_restic_backup_last_success_unixtime{job="node-exporter",instance="' ~ observability_backup_node_exporter_target ~ '",backup_set="appdata",target="b2"}',
  172800,
  'gt',
  '15m',
  'The primary appdata restic backup has not completed successfully within 48 hours.',
  'Recovery coverage for appdata is now critically stale. Fix the backup path before making further risky changes.',
  'critical',
  'homelab_backup',
  'restic',
  no_data_state='Alerting'
) }}
{{ threshold_rule(
  'homelab_backup_textfile_scrape_error',
  'Homelab backup textfile collector scrape error',
  'node_textfile_scrape_error{job="node-exporter",instance="' ~ observability_backup_node_exporter_target ~ '"}',
  0,
  'gt',
  '5m',
  'node_exporter textfile collector is reporting a scrape error on the backup host.',
  'The restic backup metrics may be malformed or unreadable. Check the generated .prom files and node_exporter logs.',
  'warning',
  'homelab_backup',
  'node-exporter',
  no_data_state='Alerting'
) }}
