{#
  EVERY `$` IN THIS FILE'S RENDERED OUTPUT IS DOUBLED, via the filter block
  wrapping the whole template. Docker Compose INTERPOLATES env_file values
  -- verified empirically, not assumed: a file containing `FOO=$BAR,x`
  reaches the container as `FOO=,x`, with $BAR expanded against an undefined
  shell variable. Compose collapses `$$` back to a single `$`, so doubling
  here is what makes the container see the literal the app was configured
  with.

  This is wrapped around the WHOLE file rather than applied per value on
  purpose. A per-value `| replace` is one that the next variable added here
  will silently not have -- which is exactly how the bug this fixes got in.

  Safe by construction: doubling only alters values that CONTAIN a `$`, and
  any such value is already corrupted today, so this can only fix, never
  break. It applies to comment lines too, which is harmless -- Compose
  ignores them.

  Nothing here carries a `$` at present (a Telegram bot token is
  `digits:alphanumeric_-`, a chat id is numeric), so this changes no rendered
  byte today. It is here so the guard predates the first value that does --
  matching digest.env.j2, chromium.env.j2 and jobs-refresh.env.j2.
#}
{% filter replace('$', '$$') %}
{# All garmin-health runtime config, including the Telegram secrets, renders
   here instead of into the 0644 myapps-compose.yml.j2 -- mirroring digest.env
   and keeping secrets out of the world-readable compose file and off `--diff`
   output. The file itself is 0600 and the task is no_log. #}
HEALTH_DATA_DIR=/data
GARMINTOKENS=/data/garmin-tokens
CLAUDE_CONFIG_DIR=/data/claude-home
ANTHROPIC_MODEL={{ myapps_garmin_health_anthropic_model }}
CLAUDE_EFFORT={{ myapps_garmin_health_claude_effort }}
CLAUDE_TIMEOUT_SECONDS={{ myapps_garmin_health_claude_timeout_seconds }}
VERIFY_MAX_STALE_DAYS={{ myapps_garmin_health_verify_max_stale_days }}
{# Unset means "save the report to /data/reports/, skip the send" (report.py
   send_telegram) -- a deploy with the Key Vault secret still missing degrades
   to an archived-but-undelivered report instead of a failed unit. #}
TELEGRAM_BOT_TOKEN={{ myapps_garmin_health_telegram_bot_token_effective | default(myapps_garmin_health_telegram_bot_token) }}
TELEGRAM_CHAT_ID={{ myapps_garmin_health_telegram_chat_id_effective | default(myapps_garmin_health_telegram_chat_id) }}
{% endfilter %}
