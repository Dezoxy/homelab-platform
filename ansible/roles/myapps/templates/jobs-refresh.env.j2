{#
  EVERY `$` IN THIS FILE'S RENDERED OUTPUT IS DOUBLED, via the filter block
  wrapping the whole template. Docker Compose INTERPOLATES env_file values
  -- verified empirically, not assumed: a file containing `FOO=$BAR,x`
  reaches the container as `FOO=,x`, with $BAR expanded against an undefined
  shell variable. Compose collapses `$$` back to a single `$`, so doubling
  here is what makes the container see the literal the app was configured
  with.

  This is wrapped around the WHOLE file rather than applied per value on
  purpose. A per-value `| replace` is one that the next variable added here
  will silently not have -- which is exactly how the bug this fixes got in.

  Safe by construction: doubling only alters values that CONTAIN a `$`, and
  any such value is already corrupted today, so this can only fix, never
  break. It applies to comment lines too, which is harmless -- Compose
  ignores them.
#}
{% filter replace('$', '$$') %}
ANTHROPIC_MODEL={{ myapps_jobs_refresh_anthropic_model }}
CLAUDE_CONFIG_DIR={{ myapps_jobs_refresh_claude_config_dir }}
# --effort for refresh-run.sh's two separate `claude --print` calls (browse,
# merge) -- NOT the same mechanism as CLAUDE_EFFORT below, which is
# notification-digest's own app-level setting. See
# myapps_jobs_refresh_browse_effort/_merge_effort in defaults/main.yml for
# valid values and why the two differ.
JOBS_REFRESH_BROWSE_EFFORT={{ myapps_jobs_refresh_browse_effort }}
JOBS_REFRESH_MERGE_EFFORT={{ myapps_jobs_refresh_merge_effort }}
JOBS_DASHBOARD_SSH_KEY_PATH={{ myapps_jobs_refresh_ssh_key_dashboard_container_path }}
EMPLOYEE_CV_SSH_KEY_PATH={{ myapps_jobs_refresh_ssh_key_employee_cv_container_path }}
JOBS_REFRESH_PUBLISH={{ (myapps_jobs_refresh_publish_enabled | default(false) | bool) | ternary('true', 'false') }}
JOBS_REFRESH_MCP_CONFIG={{ myapps_jobs_refresh_mcp_config_container_path }}
JOBS_REFRESH_BROWSER_ENABLED={{ (myapps_jobs_refresh_browser_enabled | default(false) | bool) | ternary('true', 'false') }}
# Telegram digest (refresh-run.sh step 7b). Only the literal "true" enables
# the send; see myapps_jobs_refresh_notify_enabled in defaults/main.yml for
# why this moved off GitHub Actions and why exactly one sender may be live.
# The credentials are jobs-refresh's own -- NOT digest-notify.env's alert bot.
JOBS_REFRESH_NOTIFY_ENABLED={{ (myapps_jobs_refresh_notify_enabled | default(false) | bool) | ternary('true', 'false') }}
TELEGRAM_BOT_TOKEN={{ myapps_jobs_refresh_telegram_bot_token_effective | default(myapps_jobs_refresh_telegram_bot_token | default('')) }}
TELEGRAM_CHAT_ID={{ myapps_jobs_refresh_telegram_chat_id_effective | default(myapps_jobs_refresh_telegram_chat_id | default('')) }}
# Git identity for scripts/publish.sh's commits -- a fresh container has no
# ambient ~/.gitconfig (see myapps_jobs_refresh_git_committer_name/_email in
# defaults/main.yml for why this exists and why it's set this way, not as a
# git config file). Both AUTHOR and COMMITTER are set: publish.sh runs a
# plain `git commit` with no --author override, and git requires both to be
# resolvable for every commit.
GIT_AUTHOR_NAME={{ myapps_jobs_refresh_git_committer_name }}
GIT_AUTHOR_EMAIL={{ myapps_jobs_refresh_git_committer_email }}
GIT_COMMITTER_NAME={{ myapps_jobs_refresh_git_committer_name }}
GIT_COMMITTER_EMAIL={{ myapps_jobs_refresh_git_committer_email }}
# Tracker sync (refresh-run.sh step 2b): pull the dashboard tracker from the
# Access-guarded endpoint and fold its negative verdicts into the rejected-ids
# ledger before each fetch. Empty URL = the script skips the step entirely.
# Credentials are a Cloudflare Access service token (Key Vault
# folder=jobs-refresh; see myapps_jobs_refresh_tracker_sync_url in
# defaults/main.yml).
JOBS_TRACKER_SYNC_URL={{ myapps_jobs_refresh_tracker_sync_url | default('') }}
JOBS_TRACKER_CLIENT_ID={{ myapps_jobs_refresh_tracker_client_id_effective | default(myapps_jobs_refresh_tracker_client_id | default('')) }}
JOBS_TRACKER_CLIENT_SECRET={{ myapps_jobs_refresh_tracker_client_secret_effective | default(myapps_jobs_refresh_tracker_client_secret | default('')) }}
{% endfilter %}
