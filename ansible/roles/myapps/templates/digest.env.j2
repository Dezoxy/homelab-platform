{# Rendered as a PAIR, gated on the collector's own flag. The app raises
   ConfigError when exactly one of the two is set -- correctly, since that is
   a half-finished deploy -- and that error aborts the WHOLE digest run, not
   just Patreon. So a campaign id emitted next to an empty cookie (the exact
   state while the Key Vault secret is still missing) would take the window,
   daily and weekly briefs down with it. Emitting neither is the safe half of
   that pair; tasks/main.yml additionally asserts the cookie exists whenever
   the flag is on, so "enabled but unconfigured" fails at deploy instead. #}
{% if myapps_digest_patreon_enabled | default(false) | bool %}
PATREON_CAMPAIGN_ID={{ myapps_digest_patreon_campaign_id }}
PATREON_SESSION_COOKIE={{ myapps_digest_patreon_session_cookie_effective | default(myapps_digest_patreon_session_cookie) }}
{% endif %}
TRANSLATE_HU_ENABLED={{ (myapps_digest_translate_hu_enabled | bool) | ternary('true', 'false') }}
TRANSLATE_MODEL={{ myapps_digest_translate_model }}
TRANSLATE_TIMEOUT_SECONDS={{ myapps_digest_translate_timeout_seconds }}
VERIFY_DAILY_ENABLED={{ (myapps_digest_verify_daily_enabled | bool) | ternary('true', 'false') }}
VERIFY_DAILY_TIMEOUT_SECONDS={{ myapps_digest_verify_daily_timeout_seconds }}
VERIFY_DAILY_MAX_WEB_OPS={{ myapps_digest_verify_daily_max_web_ops }}
CONTEXT_ENABLED={{ (myapps_digest_context_enabled | bool) | ternary('true', 'false') }}
CONTEXT_MAX_PER_RUN={{ myapps_digest_context_max_per_run }}
{% endfilter %}
