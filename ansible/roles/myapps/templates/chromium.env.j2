{#
  EVERY `$` IN THIS FILE'S RENDERED OUTPUT IS DOUBLED, via the filter block
  wrapping the whole template. Docker Compose INTERPOLATES env_file values
  -- verified empirically, not assumed: a file containing `FOO=$BAR,x`
  reaches the container as `FOO=,x`, with $BAR expanded against an undefined
  shell variable. Compose collapses `$$` back to a single `$`, so doubling
  here is what makes the container see the literal the app was configured
  with.

  This is wrapped around the WHOLE file rather than applied per value on
  purpose. A per-value `| replace` is one that the next variable added here
  will silently not have -- which is exactly how the bug this fixes got in.

  Safe by construction: doubling only alters values that CONTAIN a `$`, and
  any such value is already corrupted today, so this can only fix, never
  break. It applies to comment lines too, which is harmless -- Compose
  ignores them.
#}
{% filter replace('$', '$$') %}
PUID={{ myapps_chromium_puid }}
PGID={{ myapps_chromium_pgid }}
TZ={{ myapps_chromium_timezone }}
CUSTOM_USER={{ myapps_chromium_ui_user }}
PASSWORD={{ myapps_chromium_ui_password_effective | default(myapps_chromium_ui_password) }}
CHROME_CLI={{ myapps_chromium_chrome_cli }}
# Forces this baseimage-selkies image's virtual display to a desktop size
# instead of the phone-sized default it comes up at with no VNC/Selkies
# client ever attached (see myapps_chromium_display_width/height in
# defaults/main.yml for why this matters -- a real site silently failed to
# render at the phone size). CHROME_CLI's --window-size above sets Chrome's
# own window; these three set the virtual display underneath it, since a
# too-small display can still shrink the window regardless of what Chrome
# requested. Documented in linuxserver/docker-baseimage-selkies's README
# (fetched 2026-07-30): "Lock width/height to a fixed value. Setting this
# forces manual resolution mode" -- SELKIES_IS_MANUAL_RESOLUTION_MODE is the
# switch that actually locks it to those values, so all three are needed.
SELKIES_MANUAL_WIDTH={{ myapps_chromium_display_width }}
SELKIES_MANUAL_HEIGHT={{ myapps_chromium_display_height }}
SELKIES_IS_MANUAL_RESOLUTION_MODE=true
{% endfilter %}
