  path_targets = [
    {
      __address__ = "localhost",
      __path__    = "/srv/appdata/plex/Library/Application Support/Plex Media Server/Logs/Plex Media Server.log",
      job         = "media-app-file-logs",
      host        = "{{ inventory_hostname }}",
      app         = "plex",
    },
    {
      __address__ = "localhost",
      __path__    = "/srv/appdata/radarr/logs/radarr.txt",
      job         = "media-app-file-logs",
      host        = "{{ inventory_hostname }}",
      app         = "radarr",
    },
    {
      __address__ = "localhost",
      __path__    = "/srv/appdata/sonarr/logs/sonarr.txt",
      job         = "media-app-file-logs",
      host        = "{{ inventory_hostname }}",
      app         = "sonarr",
