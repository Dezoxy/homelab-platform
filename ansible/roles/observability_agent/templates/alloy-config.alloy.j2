      job         = "media-app-file-logs",
      host        = "01-torrent-lxc",
      app         = "qbittorrent",
    },
  ]
}

loki.process "media_app_logs" {
  forward_to = [loki.write.default.receiver]

  stage.match {
    selector            = "{app=\"plex\"} |~ \"QueryParser: Invalid field '(contentDirectoryID|pinnedContentDirectoryID|subtype|smart)' found, ignoring\\\\.\""
    action              = "drop"
    drop_counter_reason = "plex_queryparser_known_client_noise"
  }

  stage.match {
    selector            = "{app=\"plex\"} |= \"[UltraBlurProcessor] Failed to get color palette: Empty pixels when quantize\""
    action              = "drop"
    drop_counter_reason = "plex_ultrablur_palette_noise"
  }

  stage.match {
    selector            = "{app=\"plex\"} |= \"[UltraBlurProcessor] Failed to select colors\""
    action              = "drop"
    drop_counter_reason = "plex_ultrablur_palette_noise"
  }
}

loki.source.file "media_app_logs" {
  targets               = local.file_match.media_app_logs.targets
  forward_to            = [loki.process.media_app_logs.receiver]
  legacy_positions_file = "{{ legacy_promtail_positions_file }}"
}
{% endif %}
